{
  "$id": "https://sts-research/schemas/potion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "class": { "type": "string" },
      "name": { "$ref": "common.schema.json#/$defs/bilingual" },
      "description": { "$ref": "common.schema.json#/$defs/bilingual" },
      "rarity": { "enum": ["common", "uncommon", "rare"] },
      "potency": { "type": "integer" },
      "targetRequired": { "type": "boolean" },
      "combatOnly": { "type": "boolean" },
      "pool": { "enum": ["red", "green", "blue", "purple", "shared"] }
    },
    "required": ["id", "class", "name", "description", "rarity", "targetRequired", "combatOnly"],
    "additionalProperties": false
  }
}
